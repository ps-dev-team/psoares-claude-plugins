{
  "app": {
    "base": "https://app.example.com",
    "locale": "en-GB",
    "dismiss": ["Got it"],
    "windowX": 2600
  },
  "accounts": {
    "coach": { "cookies": "/path/to/cookies-coach.txt" },
    "client": { "cookies": "/path/to/cookies-client.txt" }
  },
  "view": { "width": 2048, "height": 1152 },
